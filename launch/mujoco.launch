<?xml version="1.0" encoding="utf-8"?>
<launch>
  <arg name="model" default="$(find mecanumrover_samples)/urdf/vmecanumrover.xacro" />
  <arg name="robot_ns" default="world" />
  <arg name="headless" default="false" />
  <arg name="mujoco_model" default="$(find mecanumrover_samples)/mujoco/mecanum.xml" />

    <!-- basic parameter -->
  <rosparam file="$(find mecanum_simulation)/config/Mujoco.yaml" command="load" ns="$(arg robot_ns)" />

  <!-- mujoco ros control -->
  <include file="$(find mujoco_ros_control)/launch/mujoco.launch" >
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="headless" value="$(arg headless)"/>
    <arg name="mujoco_model" value="$(arg mujoco_model)"/>
  </include>

    <param name="robot_description" command="$(find xacro)/xacro $(arg model) --inorder"/>
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher"/>
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

    <!-- basic parameter -->
    <arg name="rover_d" default="0.133" />
    <arg name="rover_hb" default="0.115" />
    <arg name="wheel_circumference" default="0.4775" />
    <arg name="f_l" default="0" />
    <arg name="f_r" default="1" />
    <arg name="r_l" default="2" />
    <arg name="r_r" default="3" />

  <group ns="world">

    <rosparam command="load" file="$(find mecanumrover_samples)/configuration_files/vmecanumrover_move_controller.yaml" />  
   <rosparam command="load" file="$(find mecanumrover_samples)/configuration_files/vmecanumrover_joint_state_controller.yaml" /> 
    <node name="controller_spawner" pkg="controller_manager" type="spawner" output="screen"
          args="pickmin1_joint_controller0 pickmin1_joint_controller1 pickmin1_joint_controller2 pickmin1_joint_controller3
                pickmin2_joint_controller0 pickmin2_joint_controller1 pickmin2_joint_controller2 pickmin2_joint_controller3
                pickmin3_joint_controller0 pickmin3_joint_controller1 pickmin3_joint_controller2 pickmin3_joint_controller3
                joint_state_controller"/>
  </group>

    <node name="vmecanum_twist_pickmin1" pkg="mecanumrover_samples" type="vmecanum_twist" output="screen">
      <param name="rover_d" value="$(arg rover_d)"/>
      <param name="rover_hb" value="$(arg rover_hb)"/>
      <param name="wheel_circumference" value="$(arg wheel_circumference)"/>
      <param name="f_l" value="$(arg f_l)"/>
      <param name="f_r" value="$(arg f_r)"/>
      <param name="r_l" value="$(arg r_l)"/>
      <param name="r_r" value="$(arg r_r)"/>
      <remap from="wheel0" to="/world/pickmin1_joint_controller0/command" />
      <remap from="wheel1" to="/world/pickmin1_joint_controller1/command" />
      <remap from="wheel2" to="/world/pickmin1_joint_controller2/command" />
      <remap from="wheel3" to="/world/pickmin1_joint_controller3/command" />
      <remap from="rover_twist" to="/world/pickmin1/rover_twist" />
    </node>

    <node name="vmecanum_twist_pickmin2" pkg="mecanumrover_samples" type="vmecanum_twist" output="screen">
      <param name="rover_d" value="$(arg rover_d)"/>
      <param name="rover_hb" value="$(arg rover_hb)"/>
      <param name="wheel_circumference" value="$(arg wheel_circumference)"/>
      <param name="f_l" value="$(arg f_l)"/>
      <param name="f_r" value="$(arg f_r)"/>
      <param name="r_l" value="$(arg r_l)"/>
      <param name="r_r" value="$(arg r_r)"/>
      <remap from="wheel0" to="/world/pickmin2_joint_controller0/command" />
      <remap from="wheel1" to="/world/pickmin2_joint_controller1/command" />
      <remap from="wheel2" to="/world/pickmin2_joint_controller2/command" />
      <remap from="wheel3" to="/world/pickmin2_joint_controller3/command" />
      <remap from="rover_twist" to="/world/pickmin2/rover_twist" />
    </node>

</launch>
