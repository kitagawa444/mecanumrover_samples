<mujoco model="vmecanumrover">
  <compiler angle="radian" coordinate="local"/>
    <option density="1" viscosity="1e-3"/> 
    <option timestep="0.001" gravity="0 0 -9.81" collision="all" integrator="implicit">
    <!-- 接触：反発(1/time^2)とダンピング(1/time)の目安。少し軟らかめ -->
    <flag contact="enable"/>
    </option>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="512"/>
        <texture name="body" type="cube" builtin="flat" mark="cross" width="128" height="128" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" markrgb="1 1 1" random="0.01"/>
        <material name="body" texture="body" texuniform="true" rgba="0.8 0.6 .4 1"/>
        <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
        <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
    </asset>

    <worldbody>
        <light directional="true" diffuse=".8 .8 .8" pos="0 0 10" dir="0 0 -10"/>
        <geom name="floor" size="0 0 .05" type="plane" material="grid" condim="3"/>
    </worldbody>

  <!-- URDFで使っていたメッシュをそのままassetに並べる -->
  <asset>
    <mesh name="mecanum_barrel" file="../meshes/stl/mecanum_barrel.stl"/>
    <mesh name="mecanum_wheel_rev" file="../meshes/stl/mecanum_wheel_rev.stl"/>
    <mesh name="mecanum_wheel" file="../meshes/stl/mecanum_wheel.stl"/>
    <mesh name="mecanum_body" file="../meshes/stl/mecanum_body.stl"/>
    <mesh name="mecanum_optionattachboard" file="../meshes/stl/mecanum_optionattachboard.stl"/>
    <mesh name="mecanum_button" file="../meshes/stl/mecanum_button.stl"/>
  </asset>

  <worldbody>
         <!-- 運搬オブジェクト --> 
    <body name="cargo" pos="0.0 0.0 0.3"> 
      <freejoint name="cargo_free"/> 
      <!-- 半寸法: 0.10 x 0.10 x 0.05 → 床(0)に接地するようz=0.05 --> 
      <geom name="cargo_geom" type="box" size="1.2 1.2 0.1" density="800" rgba="0.2 0.6 0.2 1" friction="1.0 0.005 0.0001" condim="3"/>
    </body> <!-- 目標位置のマーカー（任意） --> 
    <site name="cargo_goal" pos="1.2 0.0 0.001" size="0.03" rgba="1 0 0 1" type="sphere"/> 

    <!-- URDFのbase_linkをルートにする -->
    <body name="pickmin1_wrapper" pos="0.577 0 0">
      <include file="pickmin1/pickmin.xml" />
    </body>
    <body name="pickmin2_wrapper" pos="-0.288 0.5 0" euler="0 0 2.09">
      <include file="pickmin2/pickmin.xml" />
    </body>
    <body name="pickmin3_wrapper" pos="-0.288 -0.5 0" euler="0 0 -2.09">
      <include file="pickmin3/pickmin.xml" />
    </body>
  </worldbody>

  <!-- URDFでtransmissionがあったjointはmotorで生やす -->
    <actuator> 
    <!-- effort(=torque)を受ける --> 
    <!-- 車輪のモータ4つ -->
    <include file="pickmin1/actuator.xml" />
    <include file="pickmin2/actuator.xml" />
    <include file="pickmin3/actuator.xml" />
    </actuator>

</mujoco>
